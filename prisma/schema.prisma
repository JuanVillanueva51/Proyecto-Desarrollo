generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conexion {
  id       Int      @id @default(autoincrement())
  nombre   String
  usuario  String
  host     String
  puerto   Int      @default(3306)
  esquema  String?
  creadoEn DateTime @default(now())
}

model Proyecto {
  id          Int      @id @default(autoincrement())
  nombre      String
  esquemaJson String
  creadoEn    DateTime @default(now())
}
